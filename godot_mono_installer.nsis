!include "MUI2.nsh" ; Modern UI support

; ==== CONFIGURATION ====

; Require VERSION to be passed when building the installer (e.g. /DVERSION=4.2.2)
!ifndef VERSION
!error "VERSION must be defined (e.g., makensis /DVERSION=4.2.2 godot_mono_installer.nsis)"
!endif

; ==== METADATA ====
!define EXE_NAME "Godot_v${VERSION}_mono_win64.exe"
!define PRODUCT_NAME "Godot Engine Mono"
!define PRODUCT_VERSION "${VERSION}"
!define PRODUCT_PUBLISHER "Godot Engine"
!define PRODUCT_DIR_REGKEY "Software\${PRODUCT_NAME} ${PRODUCT_VERSION}"
!define PRODUCT_UNINST_KEY "${PRODUCT_NAME} ${PRODUCT_VERSION} (Mono)"
!define PRODUCT_UNINST_ROOT_KEY "HKCU" ; Install in current user scope (no admin needed)

; ==== INSTALLATION TARGETS ====
!define INSTALL_DIR "$LOCALAPPDATA\Godot"
!define STARTMENU_FOLDER "Godot"

;Request application privileges for Windows
RequestExecutionLevel user

; ==== OUTPUT FILE ====
OutFile "godot_mono_setup_${PRODUCT_VERSION}.exe"
InstallDir "${INSTALL_DIR}"

; ==== PAGES ====
Page directory       ; User chooses install directory (default: $PROFILE\Godot-...)
Page instfiles       ; Installation progress
UninstPage uninstConfirm
UninstPage instfiles

; ==== INSTALL SECTION ====
Section "Install"
    ; Set the output folder to the chosen install directory
    SetOutPath "$INSTDIR"

    ; Copy all Mono Godot files (from CI output)
    File /r "godot_build\mono\*.*"

    ; Optional: create Start Menu shortcuts
    CreateDirectory "$SMPROGRAMS\${STARTMENU_FOLDER}"
    CreateShortCut "$SMPROGRAMS\${STARTMENU_FOLDER}\Godot Mono.lnk" "$INSTDIR\${EXE_NAME}"
    CreateShortCut "$SMPROGRAMS\${STARTMENU_FOLDER}\Uninstall.lnk" "$INSTDIR\uninstall.exe"

    ; Register uninstaller in registry
    WriteUninstaller "$INSTDIR\uninstall.exe"
    WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} \
      "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_UNINST_KEY}" \
      "DisplayName" "${PRODUCT_NAME} ${PRODUCT_VERSION} (Mono)"
    WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} \
      "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_UNINST_KEY}" \
      "UninstallString" "$INSTDIR\uninstall.exe"
SectionEnd

; ==== UNINSTALL SECTION ====
Section "Uninstall"
    ; Remove main files
    Delete "$INSTDIR\${EXE_NAME}"
    Delete "$INSTDIR\uninstall.exe"
    RMDir /r "$INSTDIR"

    ; Remove Start Menu shortcuts
    Delete "$SMPROGRAMS\${STARTMENU_FOLDER}\Godot Mono.lnk"
    Delete "$SMPROGRAMS\${STARTMENU_FOLDER}\Uninstall.lnk"
    RMDir "$SMPROGRAMS\${STARTMENU_FOLDER}"

    ; Remove registry keys
    DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} \
      "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_UNINST_KEY}"
SectionEnd
