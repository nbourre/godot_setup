!include "MUI2.nsh"

!ifndef VERSION
!error "VERSION must be defined (e.g., makensis /DVERSION=4.2.2 godot_installer.nsis)"
!endif

!define EXE_NAME "Godot_v${VERSION}_win64.exe"
!define PRODUCT_NAME "Godot Engine"
!define PRODUCT_VERSION "${VERSION}"
!define PRODUCT_UNINST_KEY "${PRODUCT_NAME} ${PRODUCT_VERSION} (Standard)"
!define PRODUCT_UNINST_ROOT_KEY "HKCU"

!define INSTALL_DIR "$LOCALAPPDATA\Godot"
!define STARTMENU_FOLDER "Godot ${PRODUCT_VERSION}"

;Request application privileges for Windows
RequestExecutionLevel user

OutFile "godot_setup_${PRODUCT_VERSION}.exe"
InstallDir "${INSTALL_DIR}"

Page directory
Page instfiles
UninstPage uninstConfirm
UninstPage instfiles

Section "Install"
    SetOutPath "$INSTDIR"
    File /r "godot_build\regular\*.*"

    CreateDirectory "$SMPROGRAMS\${STARTMENU_FOLDER}"
    CreateShortCut "$SMPROGRAMS\${STARTMENU_FOLDER}\Godot.lnk" "$INSTDIR\${EXE_NAME}"
    CreateShortCut "$SMPROGRAMS\${STARTMENU_FOLDER}\Uninstall.lnk" "$INSTDIR\uninstall.exe"

    WriteUninstaller "$INSTDIR\uninstall.exe"
    WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_UNINST_KEY}" "DisplayName" "${PRODUCT_NAME} ${PRODUCT_VERSION} (Standard)"
    WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\uninstall.exe"
SectionEnd

Section "Uninstall"
    Delete "$INSTDIR\${EXE_NAME}"
    Delete "$INSTDIR\uninstall.exe"
    RMDir /r "$INSTDIR"

    Delete "$SMPROGRAMS\${STARTMENU_FOLDER}\Godot.lnk"
    Delete "$SMPROGRAMS\${STARTMENU_FOLDER}\Uninstall.lnk"
    RMDir "$SMPROGRAMS\${STARTMENU_FOLDER}"

    DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_UNINST_KEY}"
SectionEnd
